# 낯씨 환경변수 예시. 값은 비워 두고, 실제 값은 Vercel 프로젝트 설정(Environment Variables)이나
# 로컬의 backend/.env(.gitignore에 들어 있음)에만 넣으세요. 키를 이 파일이나 코드에 적지 마세요.

# Supabase (Project Settings > API). SERVICE_KEY는 서버 전용 관리자 키라 프런트에 절대 넣지 않아요.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Claude API. 없으면 AI 문장 없이 정해진 틀 문장으로 동작해요.
ANTHROPIC_API_KEY=
# 키가 여러 개면 쉼표로(앞에서부터 쓰고, 한도가 다 되거나 막힌 키는 건너뜀). 이걸 쓰면 위 칸은 비워도 돼요.
ANTHROPIC_API_KEYS=
ANTHROPIC_MODEL=

# 로컬에서 프런트(5173)를 따로 띄울 때만 쉼표로 주소를 넣어요. 배포에서는 비워 두면 같은 주소만 허용돼요.
CORS_ORIGINS=

# 기능 스위치(켤 때만 1)
NATSSI_OCR=
NATSSI_RECOVERY=
# 로그인 없이 쓰는 로컬 시험 모드. Vercel에서는 1이어도 꺼져요.
NATSSI_OPEN_MODE=

# 프런트(Vite). 백엔드가 같은 주소면 비워 둬요. 여기에는 공개되어도 되는 값만 넣어요.
VITE_API_BASE=
